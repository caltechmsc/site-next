// ============================================================================
// Caltech MSC Website - Database Schema
// ============================================================================

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

// ============================================================================
// Member System
// ============================================================================

model Member {
    id      String  @id @default(cuid())
    name    String
    aliases String? // JSON array stored as string
    email   String? @unique

    // Profile
    photo     String?
    website   String?
    position  String?
    education String?
    bio       String?
    orcid     String?

    // Classification
    category   MemberCategory @relation(fields: [categoryId], references: [id])
    categoryId String
    startDate  DateTime
    endDate    DateTime?

    // Management
    order    Int     @default(0)
    isHidden Boolean @default(false)

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    publications  MemberPublication[]
    researchAreas MemberResearchArea[]

    @@index([categoryId])
    @@index([order])
}

model MemberCategory {
    id            String  @id @default(cuid())
    name          String  @unique
    order         Int     @default(0)
    showByDefault Boolean @default(true)

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    members Member[]

    @@index([order])
}

// ============================================================================
// Publication System
// ============================================================================

model Publication {
    doi String @id

    // Basic Info
    title    String
    authors  String // JSON array stored as string
    abstract String?
    date     DateTime
    journal  String?
    volume   String?
    issue    String?
    pages    String?

    // Metadata
    topics    String? // JSON array stored as string
    citations Int     @default(0)

    // Sync
    lastSyncedAt DateTime?

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    members       MemberPublication[]
    researchAreas PublicationResearchArea[]

    @@index([date])
    @@index([citations])
}

// ============================================================================
// Research Area System
// ============================================================================

model ResearchArea {
    id       String  @id @default(cuid())
    slug     String  @unique
    title    String
    keywords String? // JSON array stored as string
    content  String? // Markdown

    // Hierarchy
    parent   ResearchArea?  @relation("ResearchAreaHierarchy", fields: [parentId], references: [id])
    parentId String?
    children ResearchArea[] @relation("ResearchAreaHierarchy")

    // Management
    order    Int     @default(0)
    isHidden Boolean @default(false)

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    members      MemberResearchArea[]
    publications PublicationResearchArea[]

    @@index([parentId])
    @@index([order])
}

// ============================================================================
// Collaborator System
// ============================================================================

model Collaborator {
    id           String  @id @default(cuid())
    organization String
    leader       String?
    email        String?
    website      String?

    // Location
    country   String?
    city      String?
    latitude  Float?
    longitude Float?

    // Management
    order    Int     @default(0)
    isHidden Boolean @default(false)

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([order])
}

// ============================================================================
// Group Photo System
// ============================================================================

model GroupPhoto {
    id       String   @id @default(cuid())
    date     DateTime
    imageUrl String
    caption  String?

    // Management
    order Int @default(0)

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([date])
    @@index([order])
}

// ============================================================================
// Admin System
// ============================================================================

model Admin {
    id           String @id @default(cuid())
    email        String @unique
    name         String
    passwordHash String
    role         String @default("editor") // "admin" | "editor"

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
